# Salin ke .env.local untuk pengembangan lokal. Jangan pernah commit .env.local.
# Di Vercel, isi nilai ini lewat Settings > Environment Variables.

# Supabase: URL dan publishable (anon) key boleh tampil di browser, RLS yang menjaga data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya di server. Dipakai satu tempat: pemilik membuat akun staf (menu Staf).
# Tanpa ini aplikasi tetap jalan, hanya fitur tambah staf yang menolak.
SUPABASE_SERVICE_ROLE_KEY=
